# Port the container listens on (host network mode → binds directly on host)
PORT=8090

# Host paths that get mounted into the container.
#
# SCRIPTS_HOST_PATH: 시나리오 스크립트 경로. 레포에 포함된 서비스별 경로가 기본값.
#   - plopvape-shop (기본): ./scenarios/services/plopvape-shop/scripts
#   - 다른 서비스로 바꾸려면 ./scenarios/services/<서비스명>/scripts 로 변경
#   - 레포 밖 경로를 써야 할 경우에만 절대경로 지정
SCRIPTS_HOST_PATH=./scenarios/services/plopvape-shop/scripts
KUBECONFIG_HOST_PATH=/root/tb-kubeconfig
SCENARIO_MANIFEST_HOST_PATH=../testbed-services/scripts/scenarios/manifests
SCENARIO_CONTRACT_HOST_PATH=../testbed-services/scripts/scenarios
CAPTURE_SCRIPT_HOST_PATH=../testbed-services/scripts/capture-eval-case.sh
STATE_HOST_PATH=./state
RUNS_HOST_PATH=./runs
EVAL_CASES_HOST_PATH=./eval-cases
CAPTURE_HOST_OUTPUT_ROOT=/root/rca-scenario-runner/eval-cases
TB_RUNNER_SSH_KEY_HOST_PATH=/root/.ssh/tb_key
SSH_KNOWN_HOSTS_HOST_PATH=/root/.ssh/known_hosts
LOGS_HOST_PATH=./logs
PROFILE_STATE_HOST_PATH=./profile-state

# Required by live-queue readiness. Keep real values only in the deployment .env.
COMMERCE_DB_PASSWORD=
PG_PASSWORD=
CH_PASSWORD=
MODEL_SNAPSHOT_SSH_TARGET=root@192.168.230.104
